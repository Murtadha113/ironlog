rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // معرّف حساب الأدمن الوحيد المسموح له يعدّل البيانات
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'lKQsNOFAKChWucEl4h1q4NaUFoX2';
    }

    // الأجهزة — يقرأها الكل، ما يعدلها إلا الأدمن
    match /machines/{machineId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // طلبات إضافة أجهزة — أي حد يقدر يرسل طلب، بس الأدمن بس يقدر يعدل الحالة
    match /pending_machines/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // بيانات المستخدمين المسجّلين (Firebase Authentication) — كل مستخدم يشوف
    // ويعدّل سجله بس، ما يقدر يوصل لسجل غيره
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
